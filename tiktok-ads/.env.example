# Google Gemini API key — https://aistudio.google.com/apikey
# Text generation works on the free tier. Video generation (Veo) is PAID TIER ONLY.
# See README "Costs and prerequisites" before running scripts/generate-clip.mjs.
GEMINI_API_KEY=

# Text model used for briefs, hooks, scripts and Veo prompt construction.
# Free-tier eligible. Configurable because Google retires model IDs on a rolling basis.
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# Video model. Lite is the cheapest tier and the default on purpose — see README.
#   veo-3.1-lite-generate-preview   $0.05/sec  ($0.40 per 8s clip)
#   veo-3.1-fast-generate-preview   $0.10/sec  ($0.80 per 8s clip)
#   veo-3.1-generate-preview        $0.40/sec  ($3.20 per 8s clip)
VEO_MODEL=veo-3.1-lite-generate-preview

# 720p | 1080p | 4k   (4k unsupported on Lite; 1080p/4k force durationSeconds=8)
VEO_RESOLUTION=720p

# 4 | 6 | 8 — Veo caps a single generation at 8 seconds.
VEO_DURATION_SECONDS=8

# Hard ceiling on clips per script run. Guards against a scheduled job
# burning your balance overnight.
VEO_MAX_CLIPS_PER_RUN=3
